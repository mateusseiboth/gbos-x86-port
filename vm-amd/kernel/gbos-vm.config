# Release string must equal the shipped one so prebuilt modules (vendor_dlkm, virtio) load.
CONFIG_LOCALVERSION="-android17-5-g3938c8d97142-ab16302624"
# CONFIG_LOCALVERSION_AUTO is not set
# The KMI symbol list used by Google's build is not public; export everything instead.
# CONFIG_TRIM_UNUSED_KSYMS is not set
# Fedora's clang 23 has warnings Google's clang 22 lacks; only the warning policy changes, not codegen.
# CONFIG_WERROR is not set
# CONFIG_OBJTOOL_WERROR is not set
